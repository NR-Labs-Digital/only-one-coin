# Fastify
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# Queue
REDIS_URL=redis://127.0.0.1:6379

# Postgres
DATABASE_URL=postgres://ooc:ooc@localhost:5432/ooc_dev

# Better Auth
BETTER_AUTH_URL=http://localhost:3000/api/auth
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
APP_PUBLIC_URLS=http://localhost:3000
# Origin of the panel, for links that leave by e-mail (staff password reset,
# OOC-30). Production: https://backoffice.onlyonecoin.edu.pe
BACKOFFICE_PUBLIC_URL=http://localhost:3000
# Origin of the student portal, for the links in the portal e-mails
# (activation and reset). Production: https://student.onlyonecoin.edu.pe
PORTAL_PUBLIC_URL=http://localhost:3000

# Storage (Tigris in production; locally the `s3` service in compose.yml —
# LocalStack, which accepts any credentials). The comprovante image never
# reaches this process's own HTTP function; this credential only mints
# presigned upload targets and lets the normalize worker GET/PUT/DELETE.
AWS_ENDPOINT_URL_S3=http://127.0.0.1:4566
AWS_REGION=us-east-1
BUCKET_NAME=ooc-dev-receipts
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# LocalStack needs the bucket in the path; Tigris resolves it from the hostname.
STORAGE_FORCE_PATH_STYLE=true
# 15 MB — a phone photo, not a scan.
RECEIPT_MAX_UPLOAD_BYTES=15000000

# OCR (packages/ocr) — every tier goes through OpenRouter (an sk-or-... key).
# Without the key, receipts are normalized and screened but never read — the
# extract worker does not start. `pnpm --filter @ooc/api ocr:eval` needs only
# these variables.
OPENROUTER_API_KEY=
# Optional — defaults to google/gemini-3.1-flash-lite.
RECEIPT_OCR_TIER1_MODEL=
# Level 2: a model of ANOTHER family (vendor) than tier 1 — the boot refuses
# the same vendor. Not chosen yet (ROADMAP Sessão 29); nothing escalates to it.
# Must support temperature and structured outputs with zero data retention on
# OpenRouter, or every call is refused.
RECEIPT_OCR_TIER2_MODEL=

# E-mail (Brevo, behind NotificationProvider)
# Only NODE_ENV=production sends to any recipient; everything else only
# reaches EMAIL_ALLOWLIST. Without a key, e-mails are rendered and logged,
# never sent.
BREVO_API_KEY=
# Secret Brevo sends back as `Authorization: Bearer` on every webhook call (OOC-91),
# 32+ characters. Without it POST /webhooks/brevo refuses everything (503).
BREVO_WEBHOOK_TOKEN=
# A sender verified in Brevo. Required when BREVO_API_KEY is set.
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=Only One Coin
# Comma-separated addresses and/or @domain entries. Empty = nobody.
# Ignored when NODE_ENV=production.
EMAIL_ALLOWLIST=

# Cloudflare Turnstile — secret key of the checkout widget (OOC-24, required
# at boot). Pairs with NEXT_PUBLIC_TURNSTILE_SITE_KEY in apps/app.
# One widget per environment: the real value goes in .env (local) or as a
# Fly secret (`fly secrets set TURNSTILE_SECRET_KEY=...`), never here.
# The value below is Cloudflare's always-passes TEST secret.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Shared with apps/app (same value on both sides, at least 32 characters):
# vouches for the student's IP the proxy forwards, so per-IP rate limits count
# students and not Vercel (OOC-24). Optional — unset, the API trusts
# X-Forwarded-For and warns at boot in production. Real value: `fly secrets
# set API_PROXY_SECRET=...` here and the same in Vercel's apps/app project.
# Generate with `openssl rand -hex 32`.
API_PROXY_SECRET=
