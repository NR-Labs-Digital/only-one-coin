{
  "name": "@ooc/api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file=.env src/index.ts | pino-pretty",
    "seed:admin": "tsx --conditions=development --env-file=.env src/scripts/seed-admin.ts",
    "seed:catalog": "tsx --conditions=development --env-file=.env src/scripts/seed-catalog.ts",
    "seed:students": "tsx --conditions=development --env-file=.env src/scripts/seed-students.ts",
    "seed:enrollments": "tsx --conditions=development --env-file=.env src/scripts/seed-enrollments.ts",
    "seed": "pnpm run seed:admin && pnpm run seed:catalog",
    "import:legacy": "tsx --conditions=development --env-file=.env src/scripts/import-legacy-enrollments.ts",
    "report:duplicate-students": "tsx --conditions=development --env-file=.env src/scripts/report-duplicate-students.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@ooc/db": "workspace:*",
    "@ooc/domain": "workspace:*",
    "@ooc/queue": "workspace:*",
    "better-auth": "^1.7.1",
    "bullmq": "^5.34.5",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.2",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
