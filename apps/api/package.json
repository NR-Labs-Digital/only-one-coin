{
  "name": "@ooc/api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file=.env src/index.ts | pino-pretty",
    "seed:admin": "tsx --conditions=development --env-file=.env src/scripts/seed-admin.ts",
    "seed:catalog": "tsx --conditions=development --env-file=.env src/scripts/seed-catalog.ts",
    "seed:students": "tsx --conditions=development --env-file=.env src/scripts/seed-students.ts",
    "seed:enrollments": "tsx --conditions=development --env-file=.env src/scripts/seed-enrollments.ts",
    "seed": "pnpm run seed:admin && pnpm run seed:catalog",
    "import:legacy": "tsx --conditions=development --env-file=.env src/scripts/import-legacy-enrollments.ts",
    "storage:cors": "tsx --conditions=development --env-file=.env src/scripts/apply-bucket-cors.ts",
    "report:duplicate-students": "tsx --conditions=development --env-file=.env src/scripts/report-duplicate-students.ts",
    "ocr:show": "tsx --conditions=development --env-file=.env src/scripts/show-receipt-ocr.ts",
    "env:required": "tsx --conditions=development src/scripts/list-required-env.ts",
    "ocr:eval": "tsx --conditions=development --env-file-if-exists=.env src/scripts/evaluate-receipt-ocr.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-presigned-post": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@ooc/db": "workspace:*",
    "@ooc/domain": "workspace:*",
    "@ooc/notifications": "workspace:*",
    "@ooc/ocr": "workspace:*",
    "@ooc/queue": "workspace:*",
    "better-auth": "^1.7.1",
    "bullmq": "^5.34.5",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "exifr": "^7.1.3",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.2",
    "file-type": "^22.1.1",
    "heic-convert": "^2.1.0",
    "ioredis": "^5.11.1",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "sharp": "^0.34.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
