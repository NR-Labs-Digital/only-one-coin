# NEXT_PUBLIC_* vai para o bundle do cliente: só chaves públicas aqui.
#
# No Vercel, cada var abaixo é scoped por ambiente (Production/Preview) na UI
# do projeto — nunca fixa aqui. Local usa os defaults deste arquivo.

# Landing pública (Astro). Opcional; fallback para a raiz do próprio app.
# Production: https://onlyonecoin.edu.pe
# NEXT_PUBLIC_LANDING_URL=https://onlyonecoin.edu.pe

# Server-only (src/server-env.ts) — endereço interno de apps/api, nunca
# exposto ao browser. Usado pelo proxy same-origin de /api/auth/*
# (docs/ARCHITECTURE.md §5.6).
# Production/Preview: URL da máquina do apps/api no Fly.io (pendente —
# entra quando o Dockerfile/fly.toml da API forem fechados).
API_INTERNAL_URL=http://localhost:3333

# Origem do bucket de comprovantes, liberada na CSP (src/middleware.ts) em
# dois lugares: `connect-src`, porque o checkout manda o comprovante direto
# pro bucket por POST assinado, e `img-src`, porque a fila de revisão do
# backoffice mostra o comprovante por URL assinada do mesmo bucket. Sem ela o
# navegador barra os dois antes de sair — o upload "falha" sem nada no
# terminal da API nem no log do bucket. Obrigatória onde houver checkout.
# Só a origem (esquema + host + porta, sem caminho nem barra final); qualquer
# outro valor é ignorado.
# Production/Preview: origem do bucket Tigris, que resolve o bucket pelo
# hostname (ex.: https://<bucket>.fly.storage.tigris.dev).
# Local: LocalStack — exatamente o host do AWS_ENDPOINT_URL_S3 de
# apps/api/.env: pra CSP, localhost e 127.0.0.1 são origens diferentes.
RECEIPT_IMAGE_ORIGIN=http://127.0.0.1:4566

# Cloudflare Turnstile — site key do widget do checkout (pública: vai no HTML).
# O par secreto (TURNSTILE_SECRET_KEY) mora só em apps/api.
# Um widget por ambiente, criado no painel da Cloudflare (Turnstile → Add
# widget), com os hostnames daquele ambiente:
#   Local: widget de dev (com `localhost` nos hostnames) — valor em .env
#   Production/Preview: site key do widget do ambiente, na UI da Vercel
# O valor abaixo é a chave de TESTE da Cloudflare que sempre passa — serve
# para rodar sem conta; casa com a secret de teste em apps/api/.env.example.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Segredo compartilhado com apps/api (mesmo valor dos dois lados, ≥ 32
# caracteres): o proxy manda o IP do aluno junto dele, e a API só acredita no
# IP com o segredo certo — sem isso o rate limit por IP contaria a Vercel, não
# o aluno (OOC-24). Opcional; vazio, a API cai no X-Forwarded-For e avisa.
# Production/Preview: na UI da Vercel (só server, nunca NEXT_PUBLIC_).
API_PROXY_SECRET=

# --- Feature flags (docs/ARCHITECTURE.md §8) ---------------------------------
#
# Ligada = a seção aparece em produção. Desligada = não existe em produção
# (some do menu, a URL dá 404) e continua inteira para nós — local, preview e,
# em produção, para quem abriu o destravamento interno.
#
# O interruptor do dia a dia é a tela Funcionalidades do backoffice
# (/backoffice/features, só para o domínio dos donos). As variáveis abaixo
# GANHAM dela: são o caminho de volta quando o painel é o que quebrou.

# Qual deploy é este. Derivada sozinha (VERCEL_ENV -> NODE_ENV) e só precisa
# ser escrita para forçar o comportamento de um ambiente noutro — por exemplo
# testar localmente o que a produção esconde.
# APP_ENV=production

# Override por flag: `on` ou `off`, qualquer outro valor é erro de boot. O nome
# sai da chave do registro (portal.payments -> OOC_FLAG_PORTAL_PAYMENTS).
# Na Vercel, cada uma é scoped por ambiente — é o que liga algo em produção
# sem mexer no código.
# OOC_FLAG_PORTAL_PAYMENTS=off
# OOC_FLAG_BACKOFFICE_REPORTS=off
# OOC_FLAG_TEACHER=off

# Segredo do destravamento interno (mín. 24 caracteres). Sem ele não há
# destravamento: /api/preview responde 404. Production/Preview: valor próprio
# por ambiente, nunca fixo aqui.
# FEATURE_PREVIEW_TOKEN=

# --- Medição do checkout público (OOC-47, docs/MEDICAO.md) -------------------
#
# Só o /enrollment carrega isto — portal, backoffice e docente nunca. Vazia =
# aquela peça não carrega. Na Vercel, scoped por ambiente: só Production leva
# os ids reais. Mesmos valores das PUBLIC_* da landing.
#
# Project API key do PostHog (EU Cloud, `phc_...`). Os eventos saem pelo
# próprio domínio (`/ooc-ev`, rewrite em next.config.ts).
# NEXT_PUBLIC_POSTHOG_KEY=
# Ids dos píxeis — só carregam depois que o visitante aceita o banner.
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Domínio-pai do cookie da resposta ao banner. Production: .onlyonecoin.edu.pe
# NEXT_PUBLIC_CONSENT_COOKIE_DOMAIN=
