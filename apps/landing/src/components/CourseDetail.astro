    flex-direction: column;
    gap: calc(6 * var(--dp));
    text-align: left;
    font-size: calc(12.8 * var(--dp));
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
  }
  .option-perks li {
    position: relative;
    padding-left: calc(20 * var(--dp));
  }
  /* O tique é desenhado em CSS, não é texto: duas bordas e uma rotação. Não
     entra no conteúdo lido em voz alta nem depende de fonte de ícone. */
  .option-perks li::before {
    content: "";
    position: absolute;
    left: calc(4 * var(--dp));
    top: calc(3 * var(--dp));
    width: calc(5 * var(--dp));
    height: calc(9 * var(--dp));
    border-right: calc(2 * var(--dp)) solid var(--yellow-deep);
    border-bottom: calc(2 * var(--dp)) solid var(--yellow-deep);
    transform: rotate(42deg);
