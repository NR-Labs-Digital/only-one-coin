---
import type { CourseSlug } from "../i18n/ui";
import { audienceAnchors, bundles, courseParent, coursePrices, extraPlans, hasKidsProgram, htmlLang, levelsOf, lowestSessionPrice, monthlyPrices, monthlySessionPrices, org, sessionPrices, whatsappUrl } from "../i18n/ui";
import type { BundleId, ExtraPlanId } from "../i18n/ui";
import { getLangFromUrl, useTranslations, withLang, formatPEN } from "../i18n/utils";
import { courseKeyOf, englishKidsCourseKey, enrollmentHref } from "../data/checkout";
import { courseContent } from "../i18n/courses-content";
import CourseProgramDetail from "./CourseProgramDetail.astro";
import LanguageFlag from "./LanguageFlag.astro";

interface Props {
  slug: CourseSlug;
}

const { slug } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const d = t.courseDetail;
const name = t.courses.list[slug];
// As formas de pagar o nível, com valor. Mensual entra só onde existe —
// inglês (CLAUDE.md §1, decisão 02/09/2026) — e só onde a coordenação já deu
// o valor. O paquete fecha a fileira e é sempre o recomendado (pedido do
// dono, 04/09/2026).
//
// O preço por sessão NÃO é uma opção de compra: ninguém paga uma aula avulsa
// (CLAUDE.md §1). Como card solto ele prometia exatamente isso, então virou
// a equivalência pendurada no paquete — o argumento de pagar tudo de uma vez.
//
// Modalidade sem preço não vira card: nunca anunciamos uma forma de pagar sem
// dizer quanto custa (CLAUDE.md §9).
const paymentOptions = (levelSlug: CourseSlug) => {
  const monthly = monthlyPrices[levelSlug] ?? null;
  const full = coursePrices[levelSlug];
  // O que o paquete entrega, dito com dado que já existe: as sessões vêm do
  // programa do próprio nível (80, 60 ou 16, conforme o curso) e a contagem
  // de talleres vem da lista de benefícios — nada de número escrito à mão que
  // envelhece quando um taller entra ou sai.
  const sessions = courseContent[lang][levelSlug]?.sessions ?? null;
  const perSession = sessionPrices[levelSlug];
  const monthlyPerSession = monthlySessionPrices[levelSlug] ?? null;
  const shortName = (levelId: CourseSlug) => d.levelShortNames[levelId] ?? t.courses.list[levelId];
  const noteOf = (value: number | null) =>
    value === null ? null : { price: formatPEN(value, lang), unit: t.hero.priceUnit };
  const workshops = d.paymentWorkshops.replace("{count}", String(t.perks.items.length));
  const perks = [
    ...(sessions === null ? [] : [d.paymentSessionsWith.replace("{sessions}", sessions)]),
    workshops,
  ];
  // Os pacotes que cobrem este nível junto com outro. A linha que os descreve
  // sai dos nomes curtos dos níveis cobertos — a combinação nunca é escrita à
  // mão, em nenhum dos três idiomas.
  const levelBundles = (Object.entries(bundles) as [BundleId, (typeof bundles)[BundleId]][])
    .filter(([, bundle]) => bundle.covers.includes(levelSlug))
    .map(([id, bundle]) => ({
      key: id,
      name: d.paymentBundleNames[id],
      amount: bundle.price,
      price: formatPEN(bundle.price, lang),
      note: noteOf(bundle.perSession),
      perks: [bundle.covers.map(shortName).join(" + "), workshops],
      recommended: false,
    }));
  // Os planos extras deste nível (2 ou 3 módulos do inglês, alemão
  // intensivo): nome e benefícios vêm do locale.
  const levelExtras = (Object.entries(extraPlans) as [ExtraPlanId, (typeof extraPlans)[ExtraPlanId]][])
    .filter(([, plan]) => plan.course === levelSlug)
    .map(([id, plan]) => ({
      key: id,
      name: d.paymentExtraNames[id],
      amount: plan.price,
      price: formatPEN(plan.price, lang),
      note: noteOf(plan.perSession),
      perks: [...d.paymentExtraPerks[id]] as string[],
      recommended: false,
    }));
  const options = [
    ...(monthly === null
      ? []
      : [
          {
            key: "monthly",
            name: d.paymentMonthlyName,
            amount: monthly,
            price: formatPEN(monthly, lang),
            note: noteOf(monthlyPerSession),
            perks: [] as string[],
            recommended: false,
          },
        ]),
    ...(full === null
      ? []
      : [
          {
            key: "full",
            name: d.paymentFullName,
            amount: full,
            price: formatPEN(full, lang),
            // Só a pílula e a unidade: "equivale a" era preâmbulo, e o que
            // importa é o número.
            note: noteOf(perSession),
            perks,
            recommended: false,
          },
        ]),
    ...levelExtras,
    ...levelBundles,
  ].sort((a, b) => a.amount - b.amount);
  // Em ordem do mais curto ao mais completo — que é a ordem de preço: mensual,
  // 2 e 3 módulos, paquete, pacote de vários níveis — e o ÚLTIMO é o
  // recomendado, o mais completo disponível ali. Um card sozinho não é o
  // recomendado de nada, é o preço.
  if (options.length > 1) options[options.length - 1].recommended = true;
  return options;
};
// Matrícula desta página já cai no checkout com ESTE curso escolhido.
// Programa real deste curso, quando a coordenação já entregou o documento.
// Sem ele a página segue no texto genérico, com o aviso de exemplo.
const program = courseContent[lang][slug] ?? null;
// O gancho do topo é o "desde" DESTE curso: o menor por sessão entre as
// formas de pagar que esta página oferece. Antes vinha do herói, que carrega
// o mínimo do site (S/0.60): japonês, a S/5, anunciava 0.60.
const hookPrice = lowestSessionPrice(slug);

// Idioma e seus níveis. A página de um idioma vira o hub da família: um
// seletor de níveis em quadradinhos, e UM painel de detalhe que troca com a
// seleção — sem navegar, sem recarregar. A página de um nível renderiza o
// mesmo hub com o próprio nível pré-selecionado, então o deep link continua
// caindo no lugar certo.
const parentSlug = courseParent[slug] ?? null;
const familyRoot = parentSlug ?? slug;
// Quem entra neste curso, por idade: o OOC Kids (6 a 12) existe só no inglês,
// e é a página do idioma que o hospeda. Todo o resto — os outros idiomas e os
// níveis acima do básico — é de 13 anos em diante e diz isso num selo.
const showsKids = hasKidsProgram(slug);
// O OOC Kids não é um nível desta página: é OUTRO curso, com chave própria no
// catálogo do checkout. Quem sai daqui matriculando uma criança tem que cair
// no curso dela — o mesmo botão dos níveis levaria ao curso de jovens e
// adultos, que é justamente o engano que esta seção existe para desfazer.
const kidsEnrollHref = enrollmentHref(withLang(lang, "/enrollment"), {
  courseKey: englishKidsCourseKey,
  content: "course_page_kids",
});
const siblings = [familyRoot, ...levelsOf(familyRoot)];
// Um curso sem níveis é uma família de um: mesmo hub, mesma cara — um único
// quadradinho já selecionado sobre o seu painel (pedido do dono, 03/09/2026).

// Checks derivados do documento do programa, para o curso que não tem
// destaque escrito à mão em `levelHighlights` — nunca inventamos conteúdo:
// sessões, nível, duração e modalidade já vêm da coordenação.
const fallbackHighlights = (prog: typeof program): string[] =>
  prog
    ? [
        prog.sessions ? `${prog.sessions} ${d.liveClasses}` : null,
        prog.level ? `${d.factLevel}: ${prog.level}` : null,
        prog.duration ? `${d.factDuration}: ${prog.duration}` : null,
        prog.modality ? `${d.factModality}: ${prog.modality}` : null,
      ].filter((item): item is string => item !== null)
    : [];

const levelPanels = siblings.map((levelSlug) => {
  const levelProgram = courseContent[lang][levelSlug] ?? null;
  return {
    slug: levelSlug,
    name: t.courses.list[levelSlug],
    shortName: d.levelShortNames[levelSlug] ?? t.courses.list[levelSlug],
    highlights: d.levelHighlights[levelSlug] ?? fallbackHighlights(levelProgram),
    program: levelProgram,
    options: paymentOptions(levelSlug),
    enrollHref: enrollmentHref(withLang(lang, "/enrollment"), {
      courseKey: courseKeyOf(levelSlug),
      content: "course_page",
    }),
    current: levelSlug === slug,
  };
});

// A troca de painel é CSS puro (radio + irmãos) — esta página não carrega
// JavaScript e continua assim. As regras dependem do id de cada nível, então
// nascem aqui e entram numa <style> própria; o visual mora na <style> scoped.
const levelTabsCss = levelPanels
  .map(
    (p) => `
#level-${p.slug}:checked ~ .level-panels > #panel-${p.slug} { display: block; }
#level-${p.slug}:checked ~ .tab-row > [for="level-${p.slug}"] {
  border-color: var(--blue);
  background: var(--sky);
  box-shadow: var(--shadow-blue);
}
#level-${p.slug}:checked ~ .tab-row > [for="level-${p.slug}"] .step:not(.step-on) {
  background: var(--paper);
}
#level-${p.slug}:focus-visible ~ .tab-row > [for="level-${p.slug}"] {
  outline: 2px solid var(--blue);
  outline-offset: 2px;
}`,
  )
  .join("\n");

// Course structured data: name, provider and the single-payment price, so the
// course pages are eligible for rich results instead of being a plain page.
const courseJsonLd = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: `${d.eyebrowPre}${name}${d.eyebrowPost}`.trim(),
  // A descrição real do programa quando existe; o texto genérico como reserva.
  description: program?.description?.join(" ") ?? `${d.leadPre}${name}${d.leadPost}`,
  inLanguage: htmlLang[lang],
  url: new URL(withLang(lang, `/courses/${slug}`), Astro.site).href,
  provider: {
    "@type": "EducationalOrganization",
    name: "Only One Coin Perú",
    legalName: org.legalName,
    url: new URL("/", Astro.site).href,
  },
  isAccessibleForFree: false,
  // Classes are always online — no campus a student attends. `courseWorkload`
  // stays out until the real period data (hours per week) exists.
  hasCourseInstance: {
    "@type": "CourseInstance",
    courseMode: "Online",
    inLanguage: htmlLang[lang],
  },
  // Sem `offers`: a página não anuncia mais o total do paquete (pedido do
  // dono, 04/09/2026), e dado estruturado que declara um preço invisível na
  // página é exatamente o que o Google trata como marcação enganosa. O preço
  // por sessão não é o preço do curso, então também não entra aqui.
};
---

<article class="course">
  <script type="application/ld+json" set:html={JSON.stringify(courseJsonLd)} is:inline />
  <div class="container">
    <a
      class="back"
      href={parentSlug ? withLang(lang, `/courses/${parentSlug}`) : withLang(lang, "/courses")}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
      {parentSlug ? `${d.parentBack} ${t.courses.list[parentSlug]}` : d.backToCourses}
    </a>

    <header class="course-head">
      {/* Urgência que corresponde a um fato: a turma tem capacidade e a vaga
          acaba (`CLAUDE.md` §5).

          A etiqueta de desconto ao lado É uma etiqueta: bico à esquerda e furo,
          como a que vem pendurada na roupa. Vermelha porque é a cor que o mundo
          inteiro lê como desconto — a única coisa fora da paleta da marca nesta
          página, e de propósito. Só em inglés, por decisão do dono
          (o preço do plano segue sendo o vigente, `CLAUDE.md` §1). */}
      <p class="badges">
        <span class="urgency">{d.urgency}</span>
        <span class="age">{d.ageBadge}</span>
      </p>
      <h1>
        {d.titlePre}
        <span class="accent name-wrap">
          <LanguageFlag slug={familyRoot} />
          {name}
          {slug === "english" && (
            <span class="discount">
              <span class="tag-string" aria-hidden="true" />
              <span class="discount-amount">{d.discountAmount}</span>
              <span class="discount-label">{d.discountLabel}</span>
            </span>
          )}
        </span>
        {d.titlePost}
      </h1>
      {/* O hero fala do curso em geral: sessões, nível e duração são dado de
          painel — moram nos checks, logo abaixo. */}
      {program || siblings.length > 1 ? (
        <div class="pitch">
          <ul class="perks">
            <li>{d.perkTeacher}</li>
            <li>{d.perkSchedule}</li>
            <li>{d.perkIncludes}</li>
          </ul>
        </div>
      ) : (
        <p class="lead text-muted">{d.leadPre}{name}{d.leadPost}</p>
      )}

      {/* O único preço da página é o da sessão — o total do paquete saiu de
          toda a landing (pedido do dono, 04/09/2026). Vale para todo curso,
          então não há mais ramo condicional. */}
      {hookPrice !== null && (
        <p class="price-hook">
          <span class="hook-pre">{d.priceHookPre}</span>
          <span class="hook-amount">
            {formatPEN(hookPrice, lang)}<span class="hook-unit">{t.hero.priceUnit}</span>
          </span>
        </p>
      )}
      {!program && <p class="example-note">{d.exampleNote}</p>}
    </header>

    {/* O OOC Kids é um CURSO à parte — não a faixa de baixo do mesmo curso.
        Enquanto ele morava num bloco "¿Para quién es?" ao lado dos níveis,
        quem chegava pelo card da home lia a página inteira como um curso só e
        acabava matriculando a criança no curso de jovens e adultos. Por isso
        ele tem card próprio, dito com todas as letras ("curso aparte"), e um
        botão que leva ao SEU curso no checkout. A âncora `#kids` é a que o
        card da home aponta. */}
    {showsKids && (
      <section class="block block-center kids-block" id={audienceAnchors[0]}>
        <h2 class="block-title">{d.kidsTitle}</h2>
        <article class="kids-card">
          <span class="tag">{d.kidsTag}</span>
          <h3>{d.kidsName}</h3>
          <p class="text-muted">{d.kidsText}</p>
          <div class="kids-actions">
            <a class="btn btn-yellow" href={kidsEnrollHref}>{d.kidsCta}</a>
            <a class="kids-wa" href={whatsappUrl} target="_blank" rel="noopener">
              {d.ctaWhatsApp}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </a>
          </div>
        </article>
      </section>
    )}

    {/* O hub de níveis: quadradinhos em cima, UM painel embaixo. Clicar num
        nível troca só o painel — radio + CSS, sem JavaScript e sem recarregar.
        O painel carrega o essencial (3–4 checks, modalidades, matrícula) e o
        programa inteiro fica atrás do "Ver detalles" dele. Curso sem níveis
        rende o mesmo painel, sem quadradinhos. */}
    {levelPanels.length > 0 && (
      <section class="block block-center level-tabs" id={audienceAnchors[1]}>
        <h2 class="block-title">{d.levelsTitle}</h2>
        {levelPanels.map((p) => (
          <input
            class="level-radio"
            type="radio"
            name="level-tab"
            id={`level-${p.slug}`}
            checked={p.current}
            aria-label={p.name}
          />
        ))}
        <div class="tab-row">
          {/* Barrinhas de progressão em vez de ícone: o quadradinho N acende
              N barras — a posição do nível na escada, sem palavra nenhuma. */}
          {levelPanels.map((p, index) => (
            <label class="tab-square" for={`level-${p.slug}`}>
              <span class="tab-steps" aria-hidden="true">
                {/* O sinal é sempre a escadinha completa; o nível pinta as
                    primeiras barras — Básico acende uma, cada degrau acima
                    acende mais uma, em qualquer idioma. */}
                {[0, 1, 2, 3].map((step) => (
                  <span
                    class={step <= index ? "step step-on" : "step"}
                    style={`height:${9 + 5 * step}px`}
                  />
                ))}
              </span>
              <span class="tab-name">{p.shortName}</span>
            </label>
          ))}
        </div>
        <div class="level-panels">
          {levelPanels.map((p) => (
            <article class="level-panel" id={`panel-${p.slug}`}>
              {/* Marca d'água do logo: decorativa, atrás do conteúdo. */}
              <img class="panel-watermark" src="/brand/logo.png" alt="" aria-hidden="true" loading="lazy" />
              {/* O nome curto basta: o idioma já está no título da página, e
                  "Inglés" sozinho aqui voltaria a ser ambíguo ao lado de
                  "Intermedio/Avanzado". */}
              <h3 class="panel-title">{p.shortName}</h3>
              {p.highlights.length > 0 && (
                <ul class="ticks panel-ticks">
                  {p.highlights.map((item) => <li>{item}</li>)}
                </ul>
              )}
              {/* Como pagar, com o valor de cada forma. */}
              {p.options.length > 0 && (
                <div class="panel-options">
                  {p.options.map((o) => (
                    <span class:list={["panel-option", { "panel-option-full": o.recommended, "panel-option-monthly": o.key === "monthly" }]}>
                      {o.recommended && (
                        <svg class="panel-option-star" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l2.9 6.26 6.6.72-4.9 4.55 1.34 6.47L12 16.77 6.06 20l1.34-6.47L2.5 8.98l6.6-.72L12 2z"/></svg>
                      )}
                      <span class="option-name">{o.name}</span>
                      <span class="option-price">{o.price}</span>
                      {/* Equivalência e selo existem em TODOS os cards, vazios
                          onde não se aplicam: sem isso o card do paquete ganha
                          duas linhas a mais e o valor dele sai do alinhamento
                          com o vizinho — justo numa fileira feita pra
                          comparar. A altura vazia vem do `min-height` em `em`
                          das duas classes. */}
                      {o.note && (
                        <span class="option-note">
                          <strong class="option-note-price">{o.note.price}</strong>
                          <span class="option-note-unit">{o.note.unit}</span>
                        </span>
                      )}
                      {o.perks.length > 0 && (
                        <ul class="option-perks">
                          {o.perks.map((perk) => <li>{perk}</li>)}
                        </ul>
                      )}
                      {o.recommended && <span class="option-flag">{d.paymentRecommended}</span>}
                    </span>
                  ))}
                </div>
              )}
              <a class="btn btn-yellow panel-enroll" href={p.enrollHref}>{t.hero.ctaEnroll}</a>
              {p.program && (
                <details class="program-toggle panel-toggle">
                  <summary>{d.detailsToggle}</summary>
                  <CourseProgramDetail program={p.program} includeOutcomes />
                </details>
              )}
            </article>
          ))}
        </div>
      </section>
    )}
    <style set:html={levelTabsCss} is:inline />

    <section class="course-cta">
      <span class="blob course-cta-blob-a" aria-hidden="true"></span>
      <span class="blob course-cta-blob-b" aria-hidden="true"></span>
      <div class="course-cta-inner">
        <div>
          <h2>{d.ctaTitlePre}<span class="accent">{d.ctaTitleAccent}</span>{d.ctaTitlePost}</h2>
          <p>{d.ctaText}</p>
        </div>
        <div class="course-cta-actions">
          <a class="btn btn-yellow" href={whatsappUrl} target="_blank" rel="noopener">{d.ctaWhatsApp}</a>
        </div>
      </div>
    </section>
  </div>
</article>

<style>
  .course {
    padding-block: calc(48 * var(--dp)) calc(88 * var(--dp));
    background:
      radial-gradient(50% 60% at 90% 0%, rgba(255, 201, 60, 0.14), transparent 60%),
      var(--sky-soft);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: calc(6 * var(--dp));
    font-weight: 600;
    color: var(--blue);
    margin-bottom: calc(26 * var(--dp));
  }
  .back svg {
    width: calc(18 * var(--dp));
    height: calc(18 * var(--dp));
    transition: transform 0.16s ease;
  }
  .back:hover svg {
    transform: translateX(calc(-3 * var(--dp)));
  }
  .course-head {
    max-width: calc(720 * var(--dp));
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(10 * var(--dp));
    margin: 0 0 calc(16 * var(--dp));
  }
  /* Etiqueta de preço, a de pendurar: bico à esquerda, furo do barbante e o
     pontilhado costurado por dentro — colada meio torta, como na vitrine.
     Tudo em CSS: acompanha o texto em qualquer idioma, sem virar imagem. */
  /* Âncora da etiqueta: o fim da palavra, não uma distância fixa — "Inglés",
     "English" e "Inglês" têm larguras diferentes. */
  .name-wrap {
    position: relative;
    display: inline-block;
  }
  .name-wrap :global(.lang-flag) {
    width: 0.7em;
    height: 0.7em;
    display: inline-block;
    vertical-align: baseline;
    margin-right: calc(4 * var(--dp));
    border-width: calc(2 * var(--dp));
  }
  /* O barbante, saindo da última letra até o furo da etiqueta. */
  .tag-string {
    position: absolute;
    left: calc(-15 * var(--dp));
    top: 50%;
    width: calc(17 * var(--dp));
    height: calc(2 * var(--dp));
    background: #c9101f;
    transform: rotate(12deg);
    border-radius: calc(2 * var(--dp));
  }
  .discount {
    position: absolute;
    left: calc(100% + calc(16 * var(--dp)));
    top: 26%;
    /* A etiqueta nunca quebra em duas linhas: ela é um objeto, não um
       parágrafo — e o título é grande demais para ela crescer em altura. */
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: calc(9 * var(--dp));
    padding: calc(13 * var(--dp)) calc(24 * var(--dp)) calc(13 * var(--dp)) calc(46 * var(--dp));
    background: linear-gradient(145deg, #ee2a36, #c9101f);
    color: #fff;
    transform: rotate(-7deg);
    clip-path: polygon(0% 50%, calc(24 * var(--dp)) 0%, 100% 0%, 100% 100%, calc(24 * var(--dp)) 100%);
    z-index: 1;
    filter: drop-shadow(0 calc(8 * var(--dp)) calc(14 * var(--dp)) rgba(201, 16, 31, 0.34));
  }
  /* Furo do barbante. Pintado da cor do fundo da seção: clip-path já recortou
     a peça, e não dá para recortar de novo por dentro. */
  .discount::before {
    content: "";
    position: absolute;
    left: calc(28 * var(--dp));
    top: 50%;
    width: calc(10 * var(--dp));
    height: calc(10 * var(--dp));
    border-radius: 50%;
    background: var(--sky-soft);
    transform: translateY(-50%);
  }
  /* A costura pontilhada, afastada da borda como na etiqueta de verdade. */
  .discount::after {
    content: "";
    position: absolute;
