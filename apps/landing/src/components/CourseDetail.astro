  /* O programa inteiro atrás de um único botão. `<details>` nativo — abre sem
     JavaScript, que esta página não carrega. O summary é o botão "Ver
     detalles", centrado; o conteúdo abre num card só, com o texto à esquerda. */
  .program-toggle > summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: calc(12 * var(--dp));
    padding: calc(15 * var(--dp)) calc(36 * var(--dp));
    background: var(--paper);
    border: calc(1.5 * var(--dp)) solid var(--border);
    border-radius: calc(999 * var(--dp));
    font-weight: 700;
    font-size: calc(16.32 * var(--dp));
    color: var(--blue-deep);
