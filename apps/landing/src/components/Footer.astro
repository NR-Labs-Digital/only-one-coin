---
import { languageSlugs, org, whatsappUrl } from "../i18n/ui";
import { fillOrgTokens, getLangFromUrl, useTranslations, withLang } from "../i18n/utils";
import LanguageFlag from "./LanguageFlag.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const f = t.footer;
const year = new Date().getFullYear();

// A razão social e o RUC não são digitados no locale: vêm de `org` pelos
// mesmos placeholders das páginas legais, para que rodapé e Términos nunca
// discordem sobre quem responde pelo site.
const orgHtml = fillOrgTokens(f.orgHtml);

const courseLangs = languageSlugs.map((slug) => ({
  slug,
  name: t.courses.list[slug],
  href: withLang(lang, `/courses/${slug}`),
}));

// Social links. Icons are not translatable content, so they live here, not in
// i18n. Only the profiles the Asociación actually runs are listed — an empty
// tile that links nowhere costs more trust than a missing network.
const socials = [
  {
    name: "Facebook",
    href: org.social.facebook,
    icon: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12z"/></svg>',
  },
  {
    name: "Instagram",
    href: org.social.instagram,
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><line x1="17.5" y1="6.5" x2="17.5" y2="6.5"/></svg>',
  },
  {
    name: "LinkedIn",
    href: org.social.linkedin,
    icon: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.94 5a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM7 8.48H3V21h4V8.48zm6.32 0H9.34V21h3.94v-6.57c0-3.66 4.77-3.96 4.77 0V21H22v-7.93c0-6.17-7.06-5.94-8.72-2.91l.04-1.68z"/></svg>',
  },
];
---

<footer class="site-footer">
  <span class="blob footer-blob" aria-hidden="true"></span>
  <div class="container footer-grid">
    <div class="col brand-col">
      <img src="/brand/logo.png" alt="Only One Coin" width="230" height="38" class="footer-logo" />
      <p class="tagline">{f.tagline}</p>
      <p class="org" set:html={orgHtml} />
      <div class="socials" aria-label={f.followTitle}>
        {
          socials.map((s) => (
            <a class="social" href={s.href} target="_blank" rel="noopener" aria-label={s.name}>
              <span set:html={s.icon} />
            </a>
          ))
        }
      </div>
    </div>

    <div class="col">
      <h3>{f.colAbout}</h3>
      <ul>
        <li><a href={withLang(lang, "/about")}>{f.aboutHistory}</a></li>
        <li><a href={withLang(lang, "/about")}>{f.aboutMission}</a></li>
        <li><a href={withLang(lang, "/about")}>{f.aboutImpact}</a></li>
      </ul>
    </div>

    <div class="col">
      <h3>{f.langsTitle}</h3>
      <ul>
        {courseLangs.map((c) => (
          <li>
            <a href={c.href} class="lang-link">
              <LanguageFlag slug={c.slug} />
              <span>{c.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="col">
      <h3>{f.colStudents}</h3>
      <ul>
        <li><a href={withLang(lang, "/login")}>{f.studentsPortal}</a></li>
        <li><a href={withLang(lang, "/courses")}>{f.studentsCourses}</a></li>
        <li><a href={withLang(lang, "/faq")}>{f.studentsCertificates}</a></li>
        <li><a href={withLang(lang, "/faq")}>{f.studentsFaq}</a></li>
      </ul>
      <h3 class="legal-title">{f.colResources}</h3>
      <ul>
        <li><a href={withLang(lang, "/blog")}>{f.resBlog}</a></li>
        <li><a href={withLang(lang, "/#benefits")}>{f.resWorkshops}</a></li>
        <li><a href={withLang(lang, "/community")}>{f.resCommunity}</a></li>
      </ul>
    </div>

    <div class="col">
      <h3>{f.colHelp}</h3>
      <ul>
        <li><a href={withLang(lang, "/contact")}>{f.helpContact}</a></li>
        <li><a href={whatsappUrl} target="_blank" rel="noopener">{f.helpWhatsapp}</a></li>
        <li><a href={withLang(lang, "/terms-and-conditions")}>{f.terms}</a></li>
        <li><a href={withLang(lang, "/privacy-policy")}>{f.privacy}</a></li>
        <!-- The complaints book (OOC-63): on every page, as the consumer
             protection rules ask. The form lives in apps/app; the path is
             sent there like /enrollment (middleware.ts). -->
        <li><a href={withLang(lang, "/libro-de-reclamaciones")}>{f.complaintsBook}</a></li>
        <li class="muted">{f.hoursLabel}</li>
        <li class="muted">{f.hours}</li>
      </ul>
      <p class="footer-script" aria-hidden="true">{f.script}</p>
    </div>
  </div>

  <!-- Strategic partner credit. Its own strip rather than a third item in the
       bottom bar: the credit belongs to NR Labs, not to the Asociación's
       copyright line, and the lockup needs room to stay legible. -->
  <div class="container footer-partner">
    <span class="partner-label">{f.partnerLabel}</span>
    <a class="partner-link" href={org.partner.url} target="_blank" rel="noopener">
      <img
        src="/brand/nr-labs-lockup.png"
        alt={org.partner.name}
        width="318"
        height="112"
        loading="lazy"
      />
    </a>
  </div>

  <div class="container footer-bottom">
    <span>© {year} {f.copyOrg} — {f.rights}</span>
    <span class="made-in">{f.madeIn}</span>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: rgba(255, 255, 255, 0.72);
    padding-top: calc(64 * var(--dp));
  }
  .footer-blob {
    width: calc(340 * var(--dp));
    height: calc(340 * var(--dp));
    top: calc(-160 * var(--dp));
    right: calc(-80 * var(--dp));
    background: var(--blue);
    opacity: 0.18;
  }
  .footer-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr 1.1fr;
    gap: calc(36 * var(--dp));
  }
  .footer-script {
    margin: calc(26 * var(--dp)) 0 0;
    font-family: var(--font-script);
    font-weight: 700;
    font-size: calc(25.6 * var(--dp));
    line-height: 1.1;
    color: var(--yellow-bright);
    transform: rotate(-4deg);
  }
  .footer-logo {
    height: calc(38 * var(--dp));
    width: auto;
    margin-bottom: calc(16 * var(--dp));
    /* Logo art is gold-on-dark; keep it bright on the navy footer */
  }
  .tagline {
    max-width: 34ch;
    margin: 0 0 calc(14 * var(--dp));
    color: rgba(255, 255, 255, 0.82);
  }
  .org {
    font-size: calc(14.4 * var(--dp));
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 calc(20 * var(--dp));
  }
  .col h3 {
    color: #fff;
    font-family: var(--font);
    font-size: calc(13.12 * var(--dp));
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: calc(16 * var(--dp));
  }
  .legal-title {
    margin-top: calc(26 * var(--dp));
  }
  .col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: calc(11 * var(--dp));
    font-size: calc(15.2 * var(--dp));
  }
  .col a {
    transition: color 0.15s ease;
  }
  .col a:hover {
    color: var(--yellow-bright);
  }
  .lang-link {
    display: inline-flex;
    align-items: center;
    gap: calc(9 * var(--dp));
  }
  .lang-link :global(.lang-flag) {
    width: calc(17 * var(--dp));
    height: calc(17 * var(--dp));
    border-color: rgba(255, 255, 255, 0.25);
  }
  .muted {
    color: rgba(255, 255, 255, 0.5);
  }
  .socials {
    display: flex;
    gap: calc(10 * var(--dp));
  }
  .social {
    width: calc(40 * var(--dp));
    height: calc(40 * var(--dp));
    display: grid;
    place-items: center;
    border-radius: calc(12 * var(--dp));
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    transition: background 0.16s ease, transform 0.16s ease, color 0.16s ease;
  }
  .social :global(svg) {
    width: calc(19 * var(--dp));
    height: calc(19 * var(--dp));
  }
  .social:hover {
    background: var(--yellow);
    color: var(--ink);
    transform: translateY(calc(-3 * var(--dp)));
  }
  .footer-partner {
    position: relative;
    z-index: 1;
    margin-top: calc(44 * var(--dp));
    padding-block: calc(20 * var(--dp));
    border-top: calc(1 * var(--dp)) solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(16 * var(--dp));
    flex-wrap: wrap;
    text-align: center;
  }
  .partner-label {
    font-size: calc(13.12 * var(--dp));
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.5);
  }
  .partner-link {
    display: inline-flex;
    align-items: center;
    opacity: 0.8;
    transition: opacity 0.16s ease, transform 0.16s ease;
  }
  .partner-link:hover {
    opacity: 1;
    transform: translateY(calc(-2 * var(--dp)));
  }
  .partner-link img {
    /* Cream-on-transparent lockup: sized by height so the 318x112 art keeps
       its ratio next to the label. */
    height: calc(30 * var(--dp));
    width: auto;
    display: block;
  }
  .footer-bottom {
    position: relative;
    z-index: 1;
    padding-block: calc(22 * var(--dp));
    border-top: calc(1 * var(--dp)) solid rgba(255, 255, 255, 0.12);
    font-size: calc(13.6 * var(--dp));
    color: rgba(255, 255, 255, 0.55);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: calc(16 * var(--dp));
    flex-wrap: wrap;
  }

  /* ——— Celular: a segunda largura de desenho (390px, global.css). ———
     Abaixo de 900px não é esta seção encolhida — é outra composição para a
     mesma seção. As cinco colunas viram duas, com a coluna
     da marca ocupando a linha inteira em cima. */
  @media (max-width: 900px) {
    .site-footer {
      padding-top: calc(40 * var(--dp));
    }
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: calc(26 * var(--dp)) calc(16 * var(--dp));
    }
    .brand-col {
      grid-column: 1 / -1;
    }
    .footer-logo {
      height: calc(30 * var(--dp));
      margin-bottom: calc(12 * var(--dp));
    }
    .tagline {
      max-width: none;
      font-size: calc(14.5 * var(--dp));
    }
    .org {
      font-size: calc(13 * var(--dp));
      margin-bottom: calc(16 * var(--dp));
    }
    .footer-script {
      margin-top: calc(18 * var(--dp));
      font-size: calc(20 * var(--dp));
    }
    .col h3 {
      font-size: calc(12 * var(--dp));
      margin-bottom: calc(12 * var(--dp));
    }
    .col ul {
      font-size: calc(13.6 * var(--dp));
      gap: calc(9 * var(--dp));
    }
    .social {
      width: calc(36 * var(--dp));
      height: calc(36 * var(--dp));
    }
    .footer-partner {
      margin-top: calc(28 * var(--dp));
    }
    .footer-bottom {
      justify-content: center;
      text-align: center;
      font-size: calc(12.5 * var(--dp));
    }
  }
</style>
